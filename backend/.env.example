# SpendWise Backend — Environment Variables (Example)
# Copy this file to .env and fill in your values

# Database
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"

# Server
PORT=3000
NODE_ENV=development

# JWT Secrets
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
